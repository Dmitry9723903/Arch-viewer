{
  "title": "Example",
  "group": [
    {
      "kind": "module",
      "from": "path-segment",
      "index": 0
    }
  ],
  "rules": [
    {
      "id": "domain-knows-only-the-kernel",
      "subject": {
        "role": "domain"
      },
      "mayReference": [
        {
          "role": "kernel"
        }
      ]
    },
    {
      "id": "adapters-serve-their-own-module",
      "subject": {
        "role": "adapters"
      },
      "mayReference": [
        {
          "role": "application",
          "same": "module"
        },
        {
          "role": "kernel"
        }
      ]
    }
  ],
  "types": {
    "by": "namespace",
    "kind": "namespace",
    "trimAssemblyPrefix": true,
    "edges": true
  },
  "readRegistrations": true
}